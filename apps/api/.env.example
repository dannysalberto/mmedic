# Connect to Postgres via the shared transaction-mode pooler (PgBouncer, port 6543)
# Parameters:
# - pgbouncer=true: disables prepared statement caching for transaction pooler compatibility
# - connection_limit=10: maximum client connections per API instance
# - pool_timeout=5: seconds to wait before failing fast with HTTP 503
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=5"

# Connect to Postgres directly (port 5432) - reserved exclusively for schema migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Application Server
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Optional Pool Configuration Overrides
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT_SECONDS=5
DB_TX_TIMEOUT_MS=10000
