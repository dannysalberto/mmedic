// Prisma Schema for MMedic System (PostgreSQL on Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ROL_SUPERADMIN
  ROL_ADMIN
  ROL_MEDICO
  ROL_CAJERO
  ROL_GERENCIA
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  patients       Patient[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username     String   @unique
  email        String   @unique
  passwordHash String
  fullName     String
  name         String?
  role         Role     @default(ROL_MEDICO)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  specialPermissions UserSpecialPermission[]
  doctorAppointments Appointment[]           @relation("DoctorAppointments")
  medicalRecords     MedicalRecord[]         @relation("DoctorRecords")

  @@index([tenantId])
  @@map("users")
}

model SpecialPermission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  module      String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  userAssignments UserSpecialPermission[]

  @@map("special_permissions")
}

model UserSpecialPermission {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   SpecialPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedBy    String?
  grantedAt    DateTime          @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_special_permissions")
}

model SystemErrorLog {
  id               String   @id @default(uuid())
  fileName         String
  lineNumber       Int
  errorMessage     String
  errorDescription String?
  userId           String?
  errorType        String
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("system_error_logs")
}

model Patient {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dni       String   @unique
  firstName String
  lastName  String
  birthDate DateTime
  gender    Gender   @default(OTHER)
  phone     String?
  email     String?
  bloodType String?
  allergies String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  @@index([tenantId])
  @@map("patients")
}

model Appointment {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dateTime  DateTime
  status    AppointmentStatus @default(PENDING)
  reason    String
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   User   @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@index([dateTime])
  @@map("appointments")
}

model MedicalRecord {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  diagnosis String
  treatment String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   User   @relation("DoctorRecords", fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@map("medical_records")
}
