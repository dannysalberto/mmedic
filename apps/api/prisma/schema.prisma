// Prisma Schema for MMedic System (PostgreSQL on Supabase)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ROL_SUPERADMIN
  ROL_ADMIN
  ROL_MEDICO
  ROL_CAJERO
  ROL_GERENCIA
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum ContributorStatus {
  ACTIVE
  INACTIVE
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  patients            Patient[]
  appointments        Appointment[]
  medicalRecords      MedicalRecord[]
  articleCategories   ArticleCategory[]
  entities            Entity[]
  contributors        Contributor[]
  articles            Article[]
  articleParticipants ArticleParticipant[]
  customers           Customer[]
  invoices            Invoice[]
  invoiceItems        InvoiceItem[]
  invoicePayments     InvoicePayment[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username     String   @unique
  email        String   @unique
  passwordHash String
  fullName     String
  name         String?
  role         Role     @default(ROL_MEDICO)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  specialPermissions UserSpecialPermission[]
  doctorAppointments Appointment[]           @relation("DoctorAppointments")
  medicalRecords     MedicalRecord[]         @relation("DoctorRecords")

  @@index([tenantId])
  @@map("users")
}

model SpecialPermission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  module      String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  userAssignments UserSpecialPermission[]

  @@map("special_permissions")
}

model UserSpecialPermission {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   SpecialPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedBy    String?
  grantedAt    DateTime          @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_special_permissions")
}

model SystemErrorLog {
  id               String   @id @default(uuid())
  fileName         String
  lineNumber       Int
  errorMessage     String
  errorDescription String?
  userId           String?
  errorType        String
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("system_error_logs")
}

model Patient {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dni       String   @unique
  firstName String
  lastName  String
  birthDate DateTime
  gender    Gender   @default(OTHER)
  phone     String?
  email     String?
  bloodType String?
  allergies String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  @@index([tenantId])
  @@map("patients")
}

model Appointment {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dateTime  DateTime
  status    AppointmentStatus @default(PENDING)
  reason    String
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   User   @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@index([dateTime])
  @@map("appointments")
}

model MedicalRecord {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  diagnosis String
  treatment String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   User   @relation("DoctorRecords", fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@map("medical_records")
}

model ArticleCategory {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("article_categories")
}

model Entity {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  articleParticipants ArticleParticipant[]
  invoiceItems        InvoiceItem[]
  contributors        Contributor[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, code])
  @@map("entities")
}

model Contributor {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  status    ContributorStatus @default(ACTIVE)

  entityId  String?
  entity    Entity?           @relation(fields: [entityId], references: [id], onDelete: SetNull)

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  invoiceItems InvoiceItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([entityId])
  @@index([tenantId, code])
  @@index([tenantId, name])
  @@map("contributors")
}

model Article {
  id         String          @id @default(uuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code       String
  name       String
  categoryId String
  category   ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  price1     Decimal         @db.Decimal(12, 2)
  price2     Decimal?        @db.Decimal(12, 2)
  price3     Decimal?        @db.Decimal(12, 2)
  price4     Decimal?        @db.Decimal(12, 2)

  isActive   Boolean         @default(true)
  appliesVat Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  participants ArticleParticipant[]
  invoiceItems InvoiceItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([categoryId])
  @@map("articles")
}

model ArticleParticipant {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  percentage Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([articleId, entityId])
  @@index([tenantId])
  @@index([articleId])
  @@index([entityId])
  @@map("article_participants")
}

enum InvoiceType {
  CASH
  CREDIT
}

enum InvoiceStatus {
  PENDING
  PAID
  VOIDED
}

enum PriceType {
  PRICE_1
  PRICE_2
  PRICE_3
  PRICE_4
}

enum PaymentMethod {
  CASH
  CARD
  CASHEA
  BINANCE
  TRANSFER
  OTHER
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxId     String
  name      String
  phone     String
  address   String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices  Invoice[]

  @@unique([tenantId, taxId])
  @@index([tenantId])
  @@index([tenantId, taxId])
  @@map("customers")
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNumber String
  issueDate     DateTime      @default(now())
  
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  type          InvoiceType   @default(CASH)
  status        InvoiceStatus @default(PENDING)
  
  subtotal      Decimal       @db.Decimal(14, 3)
  vatAmount     Decimal       @db.Decimal(14, 3)
  total         Decimal       @db.Decimal(14, 3)
  
  notes         String?
  createdById   String?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         InvoiceItem[]
  payments      InvoicePayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([issueDate])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  invoiceId  String
  invoice    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  articleId     String
  article       Article      @relation(fields: [articleId], references: [id], onDelete: Restrict)
  
  contributorId String?
  contributor   Contributor? @relation(fields: [contributorId], references: [id], onDelete: Restrict)

  entityId      String?
  entity        Entity?      @relation(fields: [entityId], references: [id], onDelete: Restrict)
  
  priceType     PriceType    @default(PRICE_1)
  quantity      Decimal      @db.Decimal(10, 3)
  
  basePrice     Decimal      @db.Decimal(14, 3)
  vatAmount     Decimal      @db.Decimal(14, 3)
  subtotal      Decimal      @db.Decimal(14, 3)
  total         Decimal      @db.Decimal(14, 3)
  
  participantsJson Json?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId])
  @@index([invoiceId])
  @@index([articleId])
  @@index([contributorId])
  @@index([entityId])
  @@map("invoice_items")
}

model InvoicePayment {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  paymentMethod  PaymentMethod @default(CASH)
  amount         Decimal       @db.Decimal(14, 3)
  receivedAmount Decimal?      @db.Decimal(14, 3)
  changeAmount   Decimal?      @db.Decimal(14, 3)
  
  reference      String?
  paymentDate    DateTime      @default(now())
  receivedById   String?
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@map("invoice_payments")
}


