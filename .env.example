# ==============================================
# MMedic Monorepo - Global Environment Variables
# ==============================================

# PostgreSQL Database (usado por Docker Compose y Prisma)
POSTGRES_USER=mmedic
POSTGRES_PASSWORD=mmedic_secure_password
POSTGRES_DB=mmedic_db
POSTGRES_PORT=5432

# URL de Conexión de Prisma para PostgreSQL
DATABASE_URL=postgresql://mmedic:mmedic_secure_password@localhost:5432/mmedic_db?schema=public

# NestJS API Backend
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_mmedic_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Android App (Emulador: 10.0.2.2, Dispositivo físico: IP local de tu PC ej: 192.168.1.X)
ANDROID_API_URL=http://10.0.2.2:3000/api/v1
