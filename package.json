{
  "name": "mmedic-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MMedic Multi-version Platform (Web, API, Android, PostgreSQL)",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:seed": "pnpm --filter api exec ts-node prisma/seed.ts",
    "db:studio": "pnpm --filter api exec prisma studio",
    "clean": "turbo clean",
    "postinstall": "pnpm --filter api exec prisma generate"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.27.1"
}
